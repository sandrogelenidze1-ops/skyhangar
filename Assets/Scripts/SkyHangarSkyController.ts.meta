  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">SkyHangarSkyController – virtual sky stand-in</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - "// @input SceneObject cameraObject {\"hint\":\"The main camera SceneObject (the user's head). The dome follows its position only.\"}"
    - '// @input Asset.RenderMesh boxMesh {"hint":"Primitive box mesh used for glyphs, trails and model parts"}'
    - '// @input Asset.RenderMesh cylinderMesh {"hint":"Primitive cylinder mesh"}'
    - '// @input Asset.RenderMesh sphereMesh {"hint":"Primitive sphere mesh"}'
    - '// @input Asset.RenderMesh coneMesh {"hint":"Primitive cone mesh"}'
    - '// @input Asset.Material litMaterial {"hint":"Lit base material (cloned per colour)"}'
    - '// @input Asset.Material unlitMaterial {"hint":"Unlit, alpha-blended base material (cloned per colour)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float skyDomeRadiusCm = 400 {"hint":"Radius of the virtual sky dome in cm (keep under the SIK interactor ray length of 500 cm)", "widget":"slider", "min":200, "max":480, "step":10}'
    - '// @input float glyphSpanCm = 13 {"hint":"Visual size of each sky glyph, cm (13 cm at 4 m is about 1.9 degrees)", "widget":"slider", "min":5, "max":40, "step":0.5}'
    - "// @input float targetRadiusCm = 28 {\"hint\":\"Radius of each marker's pinch target collider in cm — kept generous so small glyphs are easy to aim at\", \"widget\":\"slider\", \"min\":10, \"max\":60, \"step\":1}"
    - '// @input vec4 planeColor = "{0.95, 0.97, 1.0, 1.0}" {"hint":"Plane glyph colour", "widget":"color"}'
    - '// @input vec4 helicopterColor = "{1.0, 0.72, 0.28, 1.0}" {"hint":"Helicopter glyph colour", "widget":"color"}'
    - '// @input vec4 satelliteCyan = "{0.35, 0.9, 1.0, 1.0}" {"hint":"Satellite glyph colour", "widget":"color"}'
    - '// @input vec4 trailTint = "{0.45, 1.0, 0.6, 1.0}" {"hint":"Trail colour (green per the style guide); alpha fades along the path", "widget":"color"}'
    - '// @input float trailWidthCm = 1.4 {"hint":"Trail line width at the dome, cm (thin)", "widget":"slider", "min":0.3, "max":5, "step":0.1}'
    - '// @input float reticleSizeCm = 24 {"hint":"Aim reticle size (corner-bracket box side), cm at the dome", "widget":"slider", "min":8, "max":60, "step":1}'
    - '// @input float tapMaxSeconds = 0.3 {"hint":"A pinch released faster than this (s) without moving counts as a tap", "widget":"slider", "min":0.1, "max":0.8, "step":0.05}'
    - '// @input float dragStartDeg = 3 {"hint":"Ray movement (deg) during a pinch that turns it into a pull", "widget":"slider", "min":1, "max":15, "step":0.5}'
    - '// @input float dragDelaySeconds = 0.15 {"hint":"A pinch must be held this long (s) before it can turn into a pull, so a normal tap is never read as a drag", "widget":"slider", "min":0.05, "max":0.5, "step":0.01}'
    - '// @input float aimAssistDeg = 3 {"hint":"Aim assist: the vehicle nearest the gaze within this angle (deg) is aimed, and a pinch that hits nothing taps it", "widget":"slider", "min":0, "max":6, "step":0.5}'
    - '// @input bool showHorizonRing = true {"hint":"Show a faint dashed horizon ring so the stand-in sky reads clearly in preview"}'
    - '// @ui {"widget":"group_end"}'
